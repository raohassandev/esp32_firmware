menu "PV-DG controller"

config PVDG_DEVICE_NAME
    string "Device name"
    default "automatrix-pvdg"

config PVDG_PRIMARY_WIFI_SSID
    string "Default primary Wi-Fi SSID"
    default "Rao-EXT"

config PVDG_PRIMARY_WIFI_PASSWORD
    string "Default primary Wi-Fi password"
    default ""
    help
      Set the real password in the local sdkconfig, which is gitignored, so the
      credential is never committed. Leave the default empty.

config PVDG_DEFAULT_WIFI_SSID
    string "Default fallback Wi-Fi SSID"
    default "Rao1"

config PVDG_DEFAULT_WIFI_PASSWORD
    string "Default fallback Wi-Fi password"
    default ""

config PVDG_APPLY_BUILD_WIFI_PROVISIONING
    bool "Allow this build to replace stored Wi-Fi credentials"
    default n
    help
      DANGER: enabling this permits the firmware build to overwrite the primary
      and fallback Wi-Fi credentials already stored on a device, replacing them
      with the values compiled into this build.

      This is a manufacturing or field-service action. It is NOT a normal
      development-build setting. A development build that leaves this enabled
      will silently re-provision any device it is flashed onto, including one
      already commissioned on site.

      While this is disabled the firmware never applies or persists build
      provisioning, so a build from a fresh worktree cannot disturb a
      commissioned device.

config PVDG_WIFI_PROVISION_ID
    int "Wi-Fi provisioning id"
    default 0
    help
      Identifies the provisioning generation compiled into this build. It has
      no effect unless PVDG_APPLY_BUILD_WIFI_PROVISIONING is enabled.

      The id must strictly increase. Credentials are applied only when this
      value is greater than the id already stored on the device, so a build
      carrying an equal or lower id, including a fresh worktree defaulting to
      0, can never reapply credentials or roll a device back.

config PVDG_DEFAULT_ZLAN_HOST
    string "Default ZLAN5143D IP address"
    default "192.168.0.200"

config PVDG_DEFAULT_ZLAN_PORT
    int "Default ZLAN5143D TCP port"
    range 1 65535
    default 502

endmenu
