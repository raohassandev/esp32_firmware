menu "PV-DG controller"

config PVDG_DEVICE_NAME
    string "Device name"
    default "automatrix-pvdg"

config PVDG_PRIMARY_WIFI_SSID
    string "Default primary Wi-Fi SSID"
    default "Rao"

config PVDG_PRIMARY_WIFI_PASSWORD
    string "Default primary Wi-Fi password"
    default "password123"
    help
      Development credential requested for the current controller build. Replace
      this with a local sdkconfig value or an empty default before production.

config PVDG_DEFAULT_WIFI_SSID
    string "Default fallback Wi-Fi SSID"
    default "Rao1"

config PVDG_DEFAULT_WIFI_PASSWORD
    string "Default fallback Wi-Fi password"
    default ""

config PVDG_APPLY_BUILD_WIFI_PROVISIONING
    bool "Allow this build to replace stored Wi-Fi credentials"
    default y
    help
      Development provisioning is enabled for the current controller build so
      the requested primary Wi-Fi credentials are applied once. Disable this
      before production or field deployment.

config PVDG_WIFI_PROVISION_ID
    int "Wi-Fi provisioning id"
    default 1
    help
      Identifies the provisioning generation compiled into this build. The
      primary Wi-Fi credentials are applied only when this value is greater than
      the id already stored on the device.

config PVDG_DEFAULT_ZLAN_HOST
    string "Default ZLAN5143D IP address"
    default "192.168.0.200"

config PVDG_DEFAULT_ZLAN_PORT
    int "Default ZLAN5143D TCP port"
    range 1 65535
    default 502

endmenu
