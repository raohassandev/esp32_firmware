menu "Automatrix PV-DG Controller"

config PVDG_DEVICE_NAME
    string "Controller device name"
    default "Automatrix PV-DG Controller"

config PVDG_PRIMARY_WIFI_SSID
    string "Primary Wi-Fi SSID"
    default ""

config PVDG_PRIMARY_WIFI_PASSWORD
    string "Primary Wi-Fi password"
    default ""

config PVDG_DEFAULT_WIFI_SSID
    string "Default fallback Wi-Fi SSID"
    default ""

config PVDG_DEFAULT_WIFI_PASSWORD
    string "Default fallback Wi-Fi password"
    default ""

config PVDG_APPLY_BUILD_WIFI_PROVISIONING
    bool "Allow this build to replace stored Wi-Fi credentials"
    default n
    help
      Factory/development-only provisioning gate. Leave disabled for normal,
      field, customer, resale and unattended builds. When disabled, compiled
      credentials can never replace a commissioned device's stored Wi-Fi or
      static-IP configuration.

config PVDG_WIFI_PROVISION_ID
    int "Wi-Fi provisioning id"
    default 0
    help
      Factory provisioning generation. It is considered only when
      PVDG_APPLY_BUILD_WIFI_PROVISIONING is explicitly enabled. Each approved
      factory credential set must use a strictly increasing positive value.

config PVDG_ENGINEERING_CREDENTIAL_RESET_ID
    int "Engineering credential reset generation"
    default 0
    help
      Physical-recovery generation for a lost Engineering password. Leave at 0
      for every normal, field, customer and unattended build.

      When this value is positive and strictly greater than the generation
      already recorded on the device, the stored Engineering credential is
      deleted once during start-up. The controller then reports that setup is
      required and prints a one-time setup code to the serial console, exactly
      as an uncommissioned unit does, so a new password must be chosen before
      any engineering endpoint can be used again.

      No password is ever compiled into the firmware by this option: it removes
      a credential, it does not install one. Recovery therefore requires
      physical access to reflash the board and physical access to read its
      serial console, which is the same trust boundary the one-time setup code
      already relies on. Nothing about it is reachable over the network.

      Each use must take a strictly increasing positive value, so that leaving a
      recovery build installed cannot wipe the new password on every reboot.

config PVDG_DEFAULT_ZLAN_HOST
    string "Default ZLAN5143D IP address"
    default "192.168.100.200"

config PVDG_DEFAULT_ZLAN_PORT
    int "Default ZLAN5143D Modbus TCP port"
    range 1 65535
    default 502

endmenu
