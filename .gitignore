# Build output. build-<variant>/ dirs are per-toolchain/per-site builds
# (build-idf601, build-tenda, ...) and are fully regenerable — together they
# were ~308 MB of untracked noise.
build/
build-*/
sdkconfig
sdkconfig.old

# Local validation artifacts. The JSON/log evidence is small and reviewable,
# but flashed images are regenerable and must not enter git history.
evidence/**/*.bin
evidence/**/*.elf
evidence/**/*.map

# Transient build/flash transcripts, regenerated on every run.
# Validation evidence that must persist lives in verified-runtime*.log.
build-log.txt
flash-log.txt

# Fetched by the IDF component manager from idf_component.yml +
# dependencies.lock, so the lock file is committed and these are not.
managed_components/

# Local Python virtualenv
.venv/

# Editor / OS
.vscode/
*.code-workspace
.DS_Store
