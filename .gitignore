# Build output
build/
build-*/
sdkconfig
sdkconfig.old

# Qualification evidence: keep the JSON/log records, never the firmware images
evidence/**/*.bin
evidence/**/*.elf
evidence/**/*.map

# Transient build/flash transcripts, regenerated on every run.
# Validation evidence that must persist lives in verified-runtime*.log.
build-log.txt
flash-log.txt

# Fetched by the IDF component manager from idf_component.yml +
# dependencies.lock, so the lock file is committed and these are not.
managed_components/

# Local Python virtualenv
.venv/

# Editor / OS
.vscode/
*.code-workspace
.DS_Store

# Subagent worktrees; live checkouts, never part of the repo
.claude/worktrees/

# Full baseline screenshot set (130 files, ~30 MB). Regenerable from the
# committed harness in evidence/ui-baseline/. A diagnostic selection IS tracked;
# the bulk is not, following the precedent of evidence/ui-audit-2026-07-29.
evidence/ui-baseline/shots/*.png
!evidence/ui-baseline/shots/dashboard-*.png
!evidence/ui-baseline/shots/alarms-*.png
!evidence/ui-baseline/shots/readiness-1440x900-dark-operator.png
!evidence/ui-baseline/shots/meters-1440x900-light-operator.png
!evidence/ui-baseline/shots/inverters-1440x900-light-operator.png
!evidence/ui-baseline/shots/control-1440x900-light-operator.png

# Partial after-audit screenshots (run interrupted when the AP dropped)
evidence/ui-after/shots/*.png
build/screenshots/

node_modules/
package-lock.json

# Physical hardware credentials. Never committed -- this repository is public.
docs/LOCAL_CREDENTIALS.md
