(version 1)

# Global board constraints remain authoritative everywhere except the exact
# vendor-footprint geometries below. These local constraints do not relax
# unrelated copper, drill, edge, or routing rules.

# GCT USB4105-compatible USB-C footprint: the connector's own copper shell
# pads and mechanical NPTH pegs are 0.1944 mm apart in the controlled
# footprint. Preserve the vendor geometry while retaining the 0.25 mm global
# hole clearance for every other board object.
(rule "J2 USB-C internal NPTH clearance"
  (condition "A.memberOfFootprint('J2') && B.memberOfFootprint('J2')")
  (constraint hole_clearance (min 0.18mm)))

# Board-edge connectors intentionally place edge-facing copper closer to the
# routed outline. Keep the global 0.50 mm edge clearance elsewhere.
(rule "J3 RJ45 edge-facing pad clearance"
  (condition "A.memberOfFootprint('J3')")
  (constraint edge_clearance (min 0.30mm)))

# ESP32-S3-WROOM-1 is deliberately placed at the PCB edge to preserve the
# module/antenna mechanical keep-out. Keep the global 0.50 mm edge clearance
# for all other components.
(rule "U1 ESP32 module board-edge clearance"
  (condition "A.memberOfFootprint('U1')")
  (constraint edge_clearance (min 0.25mm)))

# The Espressif module exposed GND pad (pad 41) uses the controlled 0.20 mm
# plated thermal-via array. Keep the global 0.30 mm minimum drill everywhere
# else on the board.
(rule "U1 pad 41 thermal-via drill"
  (condition "A.memberOfFootprint('U1') && A.Pad_Number == '41'")
  (constraint hole_size (min 0.20mm)))
